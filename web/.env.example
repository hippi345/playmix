# Copy to .env
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# TIDAL Open API client id (same as Android local.properties tidal.client.id).
VITE_TIDAL_CLIENT_ID=your_tidal_client_id

# Must match Spotify Dashboard redirect URI exactly (dev server: 127.0.0.1:5173).
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Must match the TIDAL dashboard byte-for-byte. If you only registered 127.0.0.1, set this:
VITE_TIDAL_REDIRECT_URI=http://127.0.0.1:5173/callback

# SoundCloud — register redirect http://127.0.0.1:5173/callback at https://soundcloud.com/you/apps
# Use web/.env for real values (gitignored). The VITE_ prefix is required — without it the UI will not see the id.
VITE_SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
VITE_SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:5173/callback
# If you get invalid_client on SoundCloud, add the app "Client Secret" here — no VITE_ prefix (never use VITE_ for secrets).
# SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret
# Dev: call secure.soundcloud.com token URL directly (default: dev server handles /__soundcloud-token).
# VITE_SOUNDCLOUD_DIRECT_TOKEN=1

# Local SoundCloud playback uses GET /__soundcloud-media?url=… (dev server ports 5173 / preview 4173, or localhost)
# so hls.js avoids CDN CORS (manifestLoadError). Set to 1 only for debugging raw CDN requests:
# VITE_SOUNDCLOUD_DIRECT_MEDIA=1
# Production static build: point at your backend that forwards the same ?url= contract, e.g.
# VITE_SOUNDCLOUD_MEDIA_PROXY_BASE=https://your-server.example/soundcloud-media

# Dev only — npm terminal: lines like [spotify-proxy] GET /v1/me/playlists → 200
# (status, retry-after, content-type). Set to 0 to silence:
# VITE_SPOTIFY_PROXY_LOG=0

# Dev only — browser DevTools console: truncated JSON response bodies for each API call:
# VITE_SPOTIFY_LOG=1

# Dev only — call api.spotify.com from the browser again (no terminal proxy logs):
# VITE_SPOTIFY_DIRECT_API=1

# Dev only — TIDAL token / Open API: default uses Vite proxies (__tidal-token, __tidal/...).
# VITE_TIDAL_DIRECT_TOKEN=1
# VITE_TIDAL_DIRECT_API=1
# VITE_TIDAL_LOG=1
# VITE_TIDAL_PROXY_LOG=0
