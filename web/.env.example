# Copy to .env
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# TIDAL Open API client id (same as Android local.properties tidal.client.id).
VITE_TIDAL_CLIENT_ID=your_tidal_client_id

# Must match Spotify Dashboard redirect URI exactly (dev server: 127.0.0.1:5173).
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Must match the TIDAL dashboard byte-for-byte. If you only registered 127.0.0.1, set this:
VITE_TIDAL_REDIRECT_URI=http://127.0.0.1:5173/callback

# Dev only — npm terminal: lines like [spotify-proxy] GET /v1/me/playlists → 200
# (status, retry-after, content-type). Set to 0 to silence:
# VITE_SPOTIFY_PROXY_LOG=0

# Dev only — browser DevTools console: truncated JSON response bodies for each API call:
# VITE_SPOTIFY_LOG=1

# Dev only — call api.spotify.com from the browser again (no terminal proxy logs):
# VITE_SPOTIFY_DIRECT_API=1

# Dev only — TIDAL token / Open API: default uses Vite proxies (__tidal-token, __tidal/...).
# VITE_TIDAL_DIRECT_TOKEN=1
# VITE_TIDAL_DIRECT_API=1
# VITE_TIDAL_LOG=1
# VITE_TIDAL_PROXY_LOG=0
